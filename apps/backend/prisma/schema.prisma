generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────
// CATÁLOGO / CONFIGURACIÓN (hoy hardcodeado en constants/index.ts)
// ─────────────────────────────────────────────────────────

model Empresa {
  id          String   @id @default("1")
  nombre      String
  telefono    String   @default("")
  localidad   String   @default("")
  email       String   @default("")
  descripcion String   @default("")
  rfc         String?
  logoPath    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FactoresCalculo {
  id                    String   @id @default("1")
  factorProduccion      Float
  pagoMinimoCfe         Float
  ivaPorcentaje         Float
  inflacionCfe          Float
  factorCo2             Float
  factorArboles         Float
  factorKmAuto          Float
  areaPorPanel          Float
  factoresEstacionales  String // JSON: number[6]
  precioPanelDefault    Float
  precioInversorDefault Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Panel {
  id             String    @id @default(uuid())
  clave          String    @unique
  nombre         String
  watts          Float
  factorBifacial Float
  precioUnitario Float
  activo         Boolean   @default(true)
  orden          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  cotizaciones Cotizacion[]
}

model Inversor {
  id             String    @id @default(uuid())
  clave          String    @unique
  nombre         String
  wattsMax       Float
  precioUnitario Float
  activo         Boolean   @default(true)
  orden          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  cotizaciones Cotizacion[]
}

model Estructura {
  id        String    @id @default(uuid())
  nombre    String
  precio    Float
  activo    Boolean   @default(true)
  orden     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cotizaciones Cotizacion[]
}

model ConceptoPlantilla {
  id               String    @id @default(uuid())
  concepto         String
  costoBase        Float
  margenPorcentaje Float     @default(0)
  orden            Int       @default(0)
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model Tarifa {
  id        String   @id @default(uuid())
  codigo    String   @unique
  limiteDac Int?
  esNueva   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Localidad {
  id               String   @id @default(uuid())
  estado           String
  nombre           String
  factorProduccion Float
  horasSol         Float
  /// Mes en que arranca el verano (2-5 = FEB-MAY), según lo define CFE para la
  /// localidad. Determina cuál de los dos juegos de cuotas aplica a cada periodo
  /// del recibo. `null` en localidades sin temporada de verano diferenciada.
  mesInicioVerano  Int?
  /// Región tarifaria de DAC a la que pertenece la localidad ('Central',
  /// 'Noroeste', 'Baja California'…). CFE publica DAC por región, no por tarifa
  /// escalonada, así que sin esto no se sabe qué precio aplica.
  regionDac        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([estado, nombre])
}

model PlantillaDocumento {
  id           String   @id @default(uuid())
  tipo         String // 'ficha_panel' | 'ficha_inversor' | 'horas_sol' | 'contrato' | 'carta_poder'
  nombre       String
  rutaArchivo  String
  referenciaId String? // p.ej. clave del panel/inversor al que pertenece la ficha
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// NEGOCIO
// ─────────────────────────────────────────────────────────

model Contacto {
  id                 String    @id @default(uuid())
  codigo             String    @unique
  nombre             String
  apellidoPaterno    String    @default("")
  apellidoMaterno    String    @default("")
  telefono           String    @default("")
  celular            String    @default("")
  email              String    @default("")
  estado             String    @default("")
  localidad          String    @default("")
  fuenteContacto     String    @default("")
  estatus            String    @default("")
  notas              String    @default("")
  esEmpresa          Boolean   @default(false)
  rfc                String    @default("")
  cargo              String    @default("")
  razonSocial        String    @default("")
  actividadComercial String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  proyectos Proyecto[]
  tareas    Tarea[]
}

model Proyecto {
  id               String    @id @default(uuid())
  codigo           String    @unique
  contactoId       String
  contacto         Contacto  @relation(fields: [contactoId], references: [id])
  nombre           String
  localidadConsumo String    @default("")
  hilos            String    @default("1 hilo")
  nombreRecibo     String    @default("")
  numeroServicio   String    @default("")
  tarifa           String    @default("1A")
  usarNuevaTarifa  Boolean   @default(false)
  ivaCfe           Float     @default(16)
  aplicarDac       Boolean   @default(false)
  aplicarDap       Boolean   @default(false)
  porcentajeDap    String    @default("")
  periodo          String    @default("Bimestral")
  fechaInicio      String    @default("")
  /// Fase del funnel. Sustituye al antiguo campo `estatus` (string libre): una
  /// sola fuente de verdad, para que el tablero y el proyecto no se contradigan.
  faseId           String
  fase             FunnelFase @relation(fields: [faseId], references: [id])
  /// Posición dentro de su columna del funnel, para poder reordenar a mano.
  ordenEnFase      Int       @default(0)
  pasoActual       Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  consumos     ConsumoPeriodo[]
  cotizaciones Cotizacion[]
  tareas       Tarea[]
  documentos   Documento[]

  @@index([faseId, ordenEnFase])
}

model ConsumoPeriodo {
  id         String   @id @default(uuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  orden      Int // 0-5, 0 = periodo más reciente
  inicioStr  String   @default("")
  terminoStr String   @default("")
  kwh        Float    @default(0)
  pago       Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([proyectoId, orden])
}

model Cotizacion {
  id         String   @id @default(uuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  version    Int      @default(1)

  // Snapshot del equipo (trazabilidad vía FK opcional + valores congelados)
  panelId          String?
  panel            Panel?      @relation(fields: [panelId], references: [id])
  panelClave       String      @default("")
  panelNombre      String      @default("")
  panelWatts       Float       @default(0)
  cantPaneles      Int         @default(0)
  inversorId       String?
  inversor         Inversor?   @relation(fields: [inversorId], references: [id])
  inversorClave    String      @default("")
  inversorNombre   String      @default("")
  inversorWattsMax Float       @default(0)
  cantInversores   Int         @default(0)
  estructuraId     String?
  estructura       Estructura? @relation(fields: [estructuraId], references: [id])
  estructuraNombre String      @default("")
  estructuraPrecio Float       @default(0)

  // Snapshot de resultados
  tamanoSistemaW       Float  @default(0)
  produccionPeriodo    Float  @default(0)
  autoconsumoPct       Float  @default(0)
  nuevoPago            Float  @default(0)
  ahorroPeriodo        Float  @default(0)
  ahorroAnual          Float  @default(0)
  subtotalGeneral      Float  @default(0)
  montoDescuento       Float  @default(0)
  subtotalConDescuento Float  @default(0)
  montoIva             Float  @default(0)
  granTotal            Float  @default(0)
  roiTexto             String @default("")
  tirPorcentaje        Float  @default(0)
  kgCo2                Float  @default(0)
  arboles              Int    @default(0)
  kmAuto               Float  @default(0)

  // Flags de presentación
  metodoPrecio    String  @default("unitario")
  tipoMoneda      String  @default("MXN")
  valorDolar      Float   @default(16.9)
  incluirIva      Boolean @default(false)
  ocultarDesglose Boolean @default(false)
  descuento5      Boolean @default(false)
  descuento10     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conceptos CotizacionConcepto[]
  cargos    CotizacionCargo[]
}

model CotizacionConcepto {
  id               String     @id @default(uuid())
  cotizacionId     String
  cotizacion       Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  concepto         String
  costoBase        Float
  margenPorcentaje Float      @default(0)
  orden            Int        @default(0)
}

model CotizacionCargo {
  id           String     @id @default(uuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  nombre       String
  monto        Float
  orden        Int        @default(0)
}

model Tarea {
  id               String    @id @default(uuid())
  proyectoId       String?
  proyecto         Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  contactoId       String?
  contacto         Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  titulo           String
  descripcion      String    @default("")
  fechaVencimiento DateTime?
  completada       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Documento {
  id            String   @id @default(uuid())
  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tipo          String
  nombreArchivo String
  ruta          String
  generadoEn    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// TARIFAS CFE (pobladas por @cotizador/cfe-scraper)
//
// Nota: este modelo usa nomenclatura en inglés por decisión explícita, a
// diferencia del resto del schema. Una fila por escalón de consumo, porque el
// número de escalones varía: 3 en las tarifas 1/1A/1B y 4 en 1C–1F.
// ─────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────
// SESIÓN Y USUARIOS
// ─────────────────────────────────────────────────────────

model Usuario {
  id           String    @id @default(uuid())
  email        String    @unique
  nombre       String
  /// scrypt. Nunca se guarda la contraseña en claro ni reversible.
  passwordHash String
  salt         String
  rol          String    @default("usuario") // 'admin' | 'usuario'
  activo       Boolean   @default(true)
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sesiones Sesion[]

  @@index([rol, activo])
}

model Sesion {
  id        String   @id @default(uuid())
  /// Solo el hash del token. Si alguien lee la base de datos no obtiene
  /// credenciales utilizables.
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraEn])
}

// ─────────────────────────────────────────────────────────
// FUNNEL Y AGENDA
// ─────────────────────────────────────────────────────────

model FunnelFase {
  id        String     @id @default(uuid())
  nombre    String
  slug      String     @unique
  orden     Int
  color     String     @default("#00388d")
  /// Las fases sembradas no se pueden borrar: son las que usa el wizard.
  esSistema Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  proyectos Proyecto[]
}

model EventoAgenda {
  id          String    @id @default(uuid())
  titulo      String
  descripcion String    @default("")
  inicio      DateTime
  fin         DateTime?
  todoElDia   Boolean   @default(false)
  tipo        String    @default("evento") // 'evento' | 'visita' | 'instalacion'
  proyectoId  String?
  contactoId  String?
  usuarioId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([inicio])
}

/// Tarifa DAC. Tiene una forma distinta al resto: CFE no la publica por
/// escalones de consumo sino por **región**, como un cargo fijo mensual más un
/// precio plano por kWh. Meterla en `CfeTariffRate` habría obligado a fingir
/// escalones que no existen.
model CfeDacRate {
  id             String   @id @default(uuid())
  year           Int
  month          Int
  region         String
  /// Cargo fijo mensual, en pesos.
  cargoFijo      Float
  /// Precio por kWh. En las regiones sin temporada diferenciada es el único.
  precioKwh      Float
  /// Precio de verano, solo donde CFE lo distingue (Baja California y BCS).
  precioKwhVerano Float?
  fetchedAt      DateTime @default(now())

  @@unique([year, month, region])
  @@index([year, month])
}

model CfeTariffRate {
  id          String   @id @default(uuid())
  tariffCode  String // '1', '1A'… coincide con Tarifa.codigo
  year        Int
  month       Int // 1-12
  season      String // 'summer' | 'non_summer'
  tierIndex   Int // 0 = escalón básico
  concept     String // 'Consumo básico', 'Consumo intermedio bajo'…
  price       Float // pesos por kWh
  description String // texto original de CFE, íntegro
  limitKwh    Int? // null en el escalón excedente o si no se pudo extraer
  fetchedAt   DateTime @default(now())

  @@unique([tariffCode, year, month, season, tierIndex])
  @@index([tariffCode, year, month])
}
