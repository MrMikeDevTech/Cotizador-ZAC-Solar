{
  "name": "@cotizador/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Aplicación de escritorio Electron — Cotizador Solar",
  "author": "MrMikeDev",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "build:electron": "cd ../.. && bun build apps/desktop/electron/main.ts apps/desktop/electron/preload.ts --target=node --format=esm --outdir=apps/desktop/electron/dist --external=electron --external=better-sqlite3 --external=@prisma/client --external=@prisma/adapter-better-sqlite3",
    "start": "bun run build:electron && electron .",
    "dist": "bun run build:electron && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@cotizador/backend": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  }
}